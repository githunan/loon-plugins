#!name=酷我音乐签到
#!desc=酷我音乐自动签到、领金币、抽奖，金币达到阈值后兑换会员。打开 https://360.com/kuwo 完成网页登录。
#!author=mcdasheng688 / General74110 / bb / mirrored by githunan
#!homepage=https://github.com/githunan/loon-plugins
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/kuwosvip.png
#!date=2026-04-19

[Argument]
phone = input,"",tag=手机号,desc=用于Web登录的手机号(可留空)
ocr = input,"",tag=OCR密钥,desc=验证码识别API密钥(可留空)
notify = switch,true,tag=每次通知,desc=关闭后仅在23点发送汇总通知

[Script]
cron "15 7-23/1 * * *" script-path=https://raw.githubusercontent.com/githunan/loon-plugins/main/plugins/kuwo/scripts/kuwotask.js, timeout=120, tag=酷我音乐签到, argument=[{phone},{ocr},{notify}]

http-request ^https?:\/\/360\.com\/kuwo script-path=https://raw.githubusercontent.com/githunan/loon-plugins/main/plugins/kuwo/scripts/kuwotask.js, requires-body=true, timeout=60, tag=酷我助手面板, argument=[{phone},{ocr},{notify}]

[MITM]
hostname = 360.com
